{
  "name": "@lkonga/opencode-memory-tool",
  "version": "1.0.0",
  "description": "Persistent memory tool plugin for OpenCode \u2014 adds /memories/ scoped storage across user, session, and repo tiers",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:full": "node --test test/*.test.mjs && bun test index.test.ts"
